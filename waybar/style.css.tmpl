/* Generated by ~/.config/theme/apply-theme.sh from this template - do not edit
   the real style.css by hand, edit this file (or colors.sh) instead. */
/* waybar is a GTK3 app, so anything this file leaves unstated is supplied by
   whatever widget theme is active. That bit us on 2026-09-17: switching from
   Adwaita-dark to Colloid, whose `button` rule is

       button { min-height: 24px; min-width: 24px; padding: 5px 5px;
                border-radius: 6px; font-weight: 500; }

   widened every tag (min-width), rounded the focused tag's fill
   (border-radius) and bolded the digits (font-weight) - none of which this
   file had ever needed to say out loud. The reset below is waybar's own
   recommended idiom for exactly this, and it makes the bar independent of the
   system theme. Module-specific rules below still win on specificity. */
* {
	font-family: "{{FONT_SANS_FAMILY}}";
	font-size: {{FONT_SANS_SIZE_WAYBAR}}px;
	font-weight: normal;
	min-width: 0;
	min-height: 0;
	margin: 0;
	padding: 0;
	border: none;
	border-radius: 0;
	box-shadow: none;
	transition: none;
}

window#waybar {
	background-color: #{{BASE}};
	color: #{{SUBTEXT0}};
}

/* Geometry is stated in full rather than inherited. These are the values GTK's
   built-in Adwaita gave a flat button, which is what the bar looked like before
   the theme changed: full bar height (no margin), 5px rounding, a transparent
   1px border, and min-width 16 that the digit plus padding already exceeds.
     Adwaita: min-height:24px; min-width:16px; padding:4px 9px;
              border:1px solid; border-radius:5px
     button.flat: border-color:transparent; transition:none

   `transition: none` is the load-bearing one. Colloid styles flat buttons with
   a material ripple - `transition: ... background-size 300ms, background-image
   1200ms` - and the occupancy dot below IS a background-image, so it inherited
   a 1.2s fade in/out on every window open, close and tag switch. */
#tags button {
	padding: 0 6px;
	margin: 0;
	min-width: 16px;
	border: 1px solid transparent;
	border-radius: 5px;
	transition: none;
	background-color: transparent;
	/* Same value as the bar default, stated explicitly: GTK buttons carry their
	   own colour from the widget theme rather than reliably inheriting it. */
	color: #{{SUBTEXT0}};
}

/* Tag state is shown with a dot, not a fill: only the focused tag gets a
   background. GTK3 CSS has no ::before/::after and no `content` property, so
   the dot is a radial-gradient background image - the standard GTK idiom.
   Percentage positioning is used because GTK3 does not reliably support the
   four-value `background-position: right 4px top 4px` form.

   Rule order matters here: .occupied, .urgent and .focused all have the same
   specificity (1,1,1), so the later rule wins. urgent must therefore come
   after occupied, and the focused inversions last. */
#tags button.occupied {
	background-image: radial-gradient(circle, #{{TEXT}} 45%, transparent 50%);
	background-repeat: no-repeat;
	background-size: 5px 5px;
	background-position: 94% 12%;
}

/* Urgent is dot-only - no fill, and the tag number is left alone. An urgent
   tag is nearly always occupied too, so this just recolours that same dot. */
#tags button.urgent {
	background-color: transparent;
	background-image: radial-gradient(circle, #{{RED}} 45%, transparent 50%);
	background-repeat: no-repeat;
	background-size: 5px 5px;
	background-position: 94% 12%;
}

#tags button.focused {
	background-color: #{{MAUVE}};
	color: #{{BASE}};
}

/* The dot inverts on the focused tag for the same reason the number does -
   neither white nor red is readable on the mauve fill. */
#tags button.focused.occupied,
#tags button.focused.urgent {
	background-image: radial-gradient(circle, #{{BASE}} 45%, transparent 50%);
}

#window,
#custom-layout,
#clock,
#custom-volume,
#custom-battery,
#tray,
#custom-wifi,
#custom-bluetooth {
	padding: 0 10px;
}

/* The layout indicator is wideriver's box-drawing symbol. In the bar's sans font
   those glyphs come from a fallback font and sit short and uneven; the mono
   font draws them full-height and evenly spaced. */
#custom-layout {
	font-family: "{{FONT_MONO_FAMILY}}";
}

/* Volume + battery are icon-only as of 2026-10-09, in the bar's text colour
   (the same subtext0 as connected wifi/bluetooth). Muted = the empty volume
   circle in red. Battery states are classes set by battery-status.py:
   charging yellow (wins over low), plugged-in-and-full / held at the charge
   limit green, below 20% and not charging red. */
#custom-volume,
#custom-battery {
	color: #{{SUBTEXT0}};
}

#custom-volume.muted,
#custom-battery.low {
	color: #{{RED}};
}

#custom-battery.charging {
	color: #{{YELLOW}};
}

#custom-battery.full {
	color: #{{GREEN}};
}

/* wifi and bluetooth are icon-only as of 2026-09-18: the glyph itself never
   changes, only its colour. Dim is the resting state - powered off, or on but
   not connected - and `.connected` lifts it to the bar's own colour. The SSID
   and the list of connected devices live in the tooltip now.
     (This supersedes the 2026-09-10 note that said there was deliberately no
     colour distinction here; back then the label spelled the state out, so the
     colour had nothing to add. With the label gone, the colour IS the state.) */
#custom-wifi,
#custom-bluetooth {
	color: #{{SURFACE2}};
}

#custom-wifi.connected,
#custom-bluetooth.connected {
	color: #{{SUBTEXT0}};
}

/* The bluetooth rune is drawn lighter and smaller than the wifi arcs at the
   same size, so it reads as the weaker icon. One px back evens them out.
   Settled by eye and not worth re-deriving: 16px looked oversized, and the
   filled Font Awesome badge (U+F293), which needs no bump at all, was tried
   and rejected as too heavy. Purely optical - the `*` reset above sets every
   other module to {{FONT_SANS_SIZE_WAYBAR}}px. */
#custom-bluetooth {
	font-size: 15px;
}

/* Tooltips now carry what the labels used to, so they are styled to match the
   bar instead of inheriting whatever the GTK theme gives them. `tooltip label`
   is a separate widget from `tooltip` - padding set on the box alone does not
   reach the text. */
tooltip {
	background-color: #{{MANTLE}};
	border: 1px solid #{{SURFACE1}};
	border-radius: 6px;
}

tooltip label {
	color: #{{TEXT}};
	padding: 6px 8px;
}
