/* Generated by ~/.config/theme/apply-theme.sh from this template - do not edit
   the real colors.rasi by hand, edit this file (or colors.sh) instead. */
* {
    bg: #{{BASE}};
    bg-alt: #{{MANTLE}};
    fg: #{{TEXT}};
    fg-alt: #{{SUBTEXT0}};
    accent: #{{MAUVE}};

    /* Selected-row fill and the scrollbar handle. */
    surface0: #{{SURFACE0}};
    surface1: #{{SURFACE1}};

    /* Secondary text that should recede - the match count in the input bar.
       Catppuccin calls overlay0 its dimmest still-readable text, which is
       exactly the job. fg-alt was too close to the entry text to read as
       secondary. */
    dim: #{{OVERLAY0}};
}
