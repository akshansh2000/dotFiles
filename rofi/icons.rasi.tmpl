/* Generated by ~/.config/theme/apply-theme.sh from theme/gtk.sh - do not edit
   the real icons.rasi by hand.

   rofi does its own icon lookup and does not read the GTK settings, so without
   this it falls back to its own default theme and the launcher's icons are the
   only ones on the system that are not Papirus. Generated rather than written
   into config.rasi so the icon theme still has exactly one source of truth
   (theme/gtk.sh), the same way fonts.rasi handles the font. */
configuration {
	icon-theme: "{{GTK_ICON_THEME}}";
}
