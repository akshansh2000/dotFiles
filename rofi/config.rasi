/* Hand-edited, unlike colors.rasi / fonts.rasi / icons.rasi, which are
   generated by ~/.config/theme/apply-theme.sh. Layout and widget rules get
   tweaked far more often than the palette does, so they live here. */
@import "colors.rasi"
@import "fonts.rasi"
@import "icons.rasi"

configuration {
	modes: [ drun, run, window ];
	show-icons: true;

	/* drun/run/window put the raw mode name in the prompt, so the launcher
	   would otherwise greet you with "drun". The custom menus pass their own
	   prompt via `rofi -dmenu -p`, and are unaffected by these. */
	display-drun: "apps";
	display-run: "run";
	display-window: "windows";

	matching: "fuzzy";
	sort: true;
	/* Rank by match QUALITY (consecutive letters, word starts, prefixes), like
	   fzf - needs fuzzy matching. The default "normal" ranks by edit distance
	   to the whole entry, so a short name with a scattered match beat a
	   perfect prefix: "firef" put Bitwarden (matched through its flatpak Exec
	   line) above "Firefox Web Browser" (2026-10-01; launch history was NOT
	   the cause - disabling it changed nothing). The empty-query list still
	   follows drun's launch history. */
	sorting-method: "fzf";

	/* Smart case (2026-10-01): an all-lowercase query ignores case; any capital
	   makes it case-sensitive. Needed because every `rofi -dmenu` menu (wifi,
	   bluetooth, path, clipboard) was case-SENSITIVE: dmenu mode ignores
	   `case-sensitive: false` and the -no-case-sensitive flag (tested in a
	   nested river); only per-call `-i` or this global setting reach it. Chosen
	   over `-i` on each call as the one global switch. Cost, accepted: in the apps
	   launcher too, a query with a capital ("Firef") is now case-sensitive. */
	case-smart: true;

	/* Used by run-mode entries that want a terminal, and by drun entries with
	   Terminal=true. Default is rofi-sensible-terminal, which guesses. */
	terminal: "foot";

	/* The window is sized to the number of results rather than always being
	   `lines` tall, so a four-entry menu is a small box instead of one with two
	   empty rows. The window therefore grows and shrinks while you type.
	   NOTE: this only works because the theme is windowed. It was tried during
	   the full-screen design on 2026-09-18 and collapses the list to ZERO rows
	   there, leaving just the search bar - as do `listview { fixed-height:
	   false }` and `dynamic: true`. If this theme ever goes full-screen again,
	   this line has to go with it. */
	fixed-num-lines: false;
}

/* --- everything below is the theme ------------------------------------- */

* {
	background-color: transparent;
	text-color: @fg;
}

/* Centred by rofi itself. The width is a fixed px value rather than a
   percentage so the launcher is the same size on the laptop panel and on the
   external monitor when docked. */
window {
	width: 630px;
	background-color: @bg;
	border: 2px;
	border-color: @accent;
	border-radius: 12px;
	padding: 12px;
	children: [ body ];
}

body {
	orientation: vertical;
	spacing: 12px;
	children: [ inputbar, message, listview ];
}

inputbar {
	background-color: @bg-alt;
	padding: 12px 16px;
	spacing: 12px;
	border-radius: 10px;
	children: [ icon-ib, prompt, entry, num-filtered-rows ];
}

/* How many entries currently match - 32 on opening the launcher, dropping as
   you type. Deliberately NOT paired with `num-rows` (the total): the total
   never changes, so showing it permanently spends bar space on a constant.
     What this cannot be is a position indicator. rofi's inputbar only offers
   prompt, entry, case-indicator, num-filtered-rows and num-rows; nothing
   reports which row is highlighted, and no hook fires on cursor movement
   (script mode runs only when an entry is accepted), so "3/32 -> 4/32" while
   arrowing down is not reachable without patching rofi. The scrollbar handle
   is what gives that sense of position instead. */
num-filtered-rows {
	expand: false;
	text-color: @dim;
	vertical-align: 0.5;
}

/* A real icon from the icon theme, not a glyph from the font - so it does not
   depend on a Nerd Font being the UI font. */
icon-ib {
	expand: false;
	filename: "system-search";
	size: 1.2em;
	vertical-align: 0.5;
}

/* rofi's built-in base theme sets prompt/entry explicitly (not just via the
   wildcard `* {}` above), so without an equally-specific override here they
   keep rofi's own low-contrast default colour instead of ours - this was the
   unreadable prompt/typed-text bug. */
prompt {
	expand: false;
	text-color: @accent;
	vertical-align: 0.5;
}

entry {
	text-color: @fg;
	placeholder: "Search...";
	placeholder-color: @fg-alt;
	vertical-align: 0.5;
}

/* Shown by `rofi -dmenu -mesg`, which is what path/path-menu.sh uses for its
   notes. `rofi -e` would also work now that this theme is windowed, but -mesg
   renders inside this block and looks the same as the rest of the menu. */
message {
	background-color: @bg-alt;
	padding: 12px 16px;
	border: 0;
	border-radius: 10px;
}

textbox {
	text-color: @fg;
}

/* `border: 0` is load-bearing. rofi's base theme gives BOTH listview and
   message `border: 2px dash 0px 0px` with border-color `separatorcolor`, which
   resolves to its own stock dark-blue - that is the dotted blue line that
   appeared under the search bar. Nothing here asked for it; it is simply what
   is left when the rule is not overridden. */
listview {
	lines: 6;
	spacing: 4px;
	padding: 0;
	border: 0;
	scrollbar: true;
}

/* Always drawn, even when everything fits - rofi has no auto-hide, `@media`
   keys off the monitor rather than the window, and with three entries in a
   six-row list the handle still covers the full track (tested 2026-09-18).
   Kept anyway: it is the only thing that shows how far down a long list you
   are, which the counter cannot say. Thin and surface1 so it stays quiet when
   it has nothing to report. */
scrollbar {
	width: 4px;
	handle-width: 4px;
	handle-color: @surface1;
}

element {
	padding: 9px 12px;
	spacing: 14px;
	border-radius: 8px;
}

/* State-qualified selectors, and they have to be: rofi's base theme styles
   rows through `element normal.normal`, `element alternate.normal` and
   `element selected.normal`, and those beat a plain `element {}` or
   `element selected {}` no matter the load order. Leaving `alternate` out is
   what had every second row rendering in rofi's stock Solarized-light cream,
   and leaving `selected.normal` out is what made the selected row slate grey
   instead of using the palette. */
element normal.normal, element alternate.normal {
	background-color: transparent;
	text-color: @fg;
}

element selected.normal {
	background-color: @surface0;
	text-color: @accent;
}

/* vertical-align on both, or a 1.6em icon and a 13pt label sit on different
   centre lines inside the selected block. */
element-icon {
	size: 1.6em;
	vertical-align: 0.5;
}

element-text {
	background-color: transparent;
	vertical-align: 0.5;
}
