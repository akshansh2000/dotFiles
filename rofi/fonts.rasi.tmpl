/* Generated by ~/.config/theme/apply-theme.sh from theme/fonts.sh - do not edit
   the real fonts.rasi by hand.

   Kept separate from config.rasi (which imports this alongside colors.rasi) so
   that config.rasi stays hand-editable: the layout and widget rules there get
   tweaked far more often than the font does, and editing a .tmpl plus re-running
   a script for every visual experiment would be friction in the wrong place. */
configuration {
	font: "{{FONT_SANS_FAMILY}} {{FONT_SANS_SIZE_ROFI}}";
}
