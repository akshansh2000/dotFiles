# Generated by ~/.config/theme/apply-theme.sh from this template - do not edit
# the real theme.toml by hand, edit this file (or colors.sh) instead.
#
# Only overriding what needs to change - yazi merges this over its own
# built-in preset (theme-dark.toml), so anything left out keeps upstream's
# default. Everything below used to be a plain ANSI color name ("blue",
# "gray", "darkgray", ...) resolved through the terminal palette; that's
# what made the `which`-key hints and permission separators unreadable -
# Catppuccin Mocha's ANSI slot 8 ("darkgray") is only ~1.8:1 contrast
# against the background (regular1-6 and bright1-6 are also identical, see
# foot.ini's comment), well under the ~4.5:1 that's readable. Hex values
# here sidestep the ANSI palette entirely.

[mgr]
cwd = { fg = "#{{BLUE}}" }

find_keyword  = { fg = "#{{YELLOW}}", bold = true, italic = true, underline = true }
find_position = { fg = "#{{PINK}}", bg = "reset", bold = true, italic = true }

marker_copied   = { fg = "#{{GREEN}}", bg = "#{{GREEN}}" }
marker_cut      = { fg = "#{{RED}}",   bg = "#{{RED}}" }
marker_marked   = { fg = "#{{TEAL}}",    bg = "#{{TEAL}}" }
marker_selected = { fg = "#{{MAUVE}}", bg = "#{{MAUVE}}" }

count_copied   = { fg = "#{{BASE}}", bg = "#{{GREEN}}" }
count_cut      = { fg = "#{{BASE}}", bg = "#{{RED}}" }
count_selected = { fg = "#{{BASE}}", bg = "#{{MAUVE}}" }

border_style = { fg = "#{{SURFACE1}}" }

[tabs]
active   = { fg = "#{{BASE}}",    bg = "#{{MAUVE}}", bold = true }
inactive = { fg = "#{{SUBTEXT0}}", bg = "#{{MANTLE}}" }

[mode]
normal_main = { fg = "#{{BASE}}",  bg = "#{{MAUVE}}",    bold = true }
normal_alt  = { fg = "#{{MAUVE}}", bg = "#{{SURFACE1}}" }
select_main = { fg = "#{{BASE}}",  bg = "#{{RED}}",       bold = true }
select_alt  = { fg = "#{{RED}}",   bg = "#{{SURFACE1}}" }
unset_main  = { fg = "#{{BASE}}",  bg = "#{{RED}}",       bold = true }
unset_alt   = { fg = "#{{RED}}",   bg = "#{{SURFACE1}}" }

[status]
perm_sep   = { fg = "#{{SUBTEXT0}}" }
perm_type  = { fg = "#{{GREEN}}" }
perm_read  = { fg = "#{{YELLOW}}" }
perm_write = { fg = "#{{RED}}" }
perm_exec  = { fg = "#{{TEAL}}" }

progress_normal = { fg = "#{{GREEN}}", bg = "#{{SURFACE1}}" }
progress_error  = { fg = "#{{BASE}}",  bg = "#{{RED}}" }

[input]
border   = { fg = "#{{MAUVE}}" }
selected = { fg = "#{{BASE}}", bg = "#{{MAUVE}}" }

[tasks]
border  = { fg = "#{{MAUVE}}" }
hovered = { fg = "#{{MAUVE}}", bold = true }

[which]
border          = { fg = "#{{MAUVE}}" }
cand            = { fg = "#{{BLUE}}" }
rest            = { fg = "#{{SUBTEXT0}}" }
desc            = { fg = "#{{SUBTEXT0}}", italic = true }
separator_style = { fg = "#{{SURFACE1}}" }

[confirm]
border  = { fg = "#{{MAUVE}}" }
title   = { fg = "#{{MAUVE}}" }
btn_yes = { fg = "#{{BASE}}", bg = "#{{GREEN}}" }

[notify]
title_info  = { fg = "#{{GREEN}}" }
title_warn  = { fg = "#{{YELLOW}}" }
title_error = { fg = "#{{RED}}" }

[pick]
border = { fg = "#{{MAUVE}}" }
active = { fg = "#{{MAUVE}}", bold = true }

[help]
border  = { fg = "#{{MAUVE}}" }
chord   = { fg = "#{{BLUE}}" }
hovered = { fg = "#{{BASE}}", bg = "#{{MAUVE}}", bold = true }

[cmp]
border   = { fg = "#{{MAUVE}}" }
active   = { fg = "#{{BASE}}", bg = "#{{MAUVE}}" }

[spot]
border   = { fg = "#{{MAUVE}}" }
title    = { fg = "#{{MAUVE}}" }
tbl_col  = { fg = "#{{BLUE}}" }
tbl_cell = { fg = "#{{BASE}}", bg = "#{{YELLOW}}" }

[filetype]
rules = [
	{ mime = "**/image/*", fg = "#{{YELLOW}}" },
	{ mime = "**/{audio,video}/*", fg = "#{{PINK}}" },
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#{{RED}}" },
	{ mime = "**/application/{pdf,doc,rtf}", fg = "#{{TEAL}}" },
	{ mime = "vfs/{absent,stale}", fg = "#{{SURFACE1}}" },
	{ url = "*", is = "orphan", bg = "#{{RED}}" },
	{ url = "*", is = "exec"  , fg = "#{{GREEN}}" },
	{ url = "*", is = "dummy", bg = "#{{RED}}" },
	{ url = "*/", is = "dummy", bg = "#{{RED}}" },
	{ url = "*/", fg = "#{{BLUE}}" },
]
