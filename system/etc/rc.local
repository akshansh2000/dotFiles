#!/bin/sh
# Default rc.local for void; add your custom commands here.
#
# This is run by runit in stage 2 before the services are executed
# (see /etc/runit/2).

# Keyboard backlight on at boot - runs as root here, independent of any
# river/graphical session, so it applies in plain tty mode too.
for i in 1 2 3 4 5; do /home/akshansh/.config/river/kbd-backlight set 1 && break; sleep 1; done
