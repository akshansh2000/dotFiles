[Settings]
# GENERATED by ~/.config/theme/apply-theme.sh from theme/gtk.sh + theme/fonts.sh
# - do not edit settings.ini by hand. This one template renders to BOTH
# gtk-3.0/settings.ini and gtk-4.0/settings.ini, and apply-theme.sh issues the
# matching `gsettings set org.gnome.desktop.interface` calls, because GTK reads
# appearance from both places and they must agree - see theme/gtk.sh.
#
# gtk-application-prefer-dark-theme stays on even though the theme name already
# says Dark: apps that only honour the flag (rather than the name) still need it.
gtk-theme-name={{GTK_THEME_NAME}}
gtk-application-prefer-dark-theme=1
gtk-icon-theme-name={{GTK_ICON_THEME}}
gtk-cursor-theme-name={{GTK_CURSOR_THEME}}
gtk-cursor-theme-size={{GTK_CURSOR_SIZE}}
gtk-font-name={{FONT_SANS_FAMILY}} {{FONT_SANS_SIZE_GTK}}
