# Generated by ~/.config/theme/apply-theme.sh from this template - do not edit
# the real alacritty.toml by hand, edit this file (or colors.sh/fonts.sh) instead.
# Fallback terminal - foot is primary, this just needs to match the theme.

# Monospace font - single source of truth is theme/fonts.sh, not this file.
[font]
size = {{FONT_MONO_SIZE_ALACRITTY}}

[font.normal]
family = "{{FONT_MONO_FAMILY}}"

[colors.primary]
background = "#{{BASE}}"
foreground = "#{{TEXT}}"

[colors.normal]
black   = "#{{MANTLE}}"
red     = "#{{RED}}"
green   = "#{{GREEN}}"
yellow  = "#{{YELLOW}}"
blue    = "#{{BLUE}}"
magenta = "#{{MAUVE}}"
cyan    = "#{{BLUE}}"
white   = "#{{TEXT}}"

[colors.bright]
black   = "#{{SUBTEXT0}}"
red     = "#{{RED}}"
green   = "#{{GREEN}}"
yellow  = "#{{YELLOW}}"
blue    = "#{{BLUE}}"
magenta = "#{{MAUVE}}"
cyan    = "#{{BLUE}}"
white   = "#{{TEXT}}"

[colors.cursor]
text   = "#{{BASE}}"
cursor = "#{{TEXT}}"

# Links (2026-10-17): Ctrl+click opens a URL or OSC 8 hyperlink, matching
# tmux's Ctrl+click; Ctrl+Shift+O labels them all, as in foot. This restates
# alacritty's default hint - defining any hint replaces the whole default list -
# changing only mouse.mods (default: plain click, too easy to hit by accident).
[[hints.enabled]]
command = "xdg-open"
hyperlinks = true
post_processing = true
persist = false
mouse.enabled = true
mouse.mods = "Control"
binding = { key = "O", mods = "Control|Shift" }
regex = "(ipfs:|ipns:|magnet:|mailto:|gemini://|gopher://|https://|http://|news:|file:|git://|ssh:|ftp://)[^\u0000-\u001F\u007F-\u009F<>\"\\s{-}\\^⟨⟩`\\\\]+"
