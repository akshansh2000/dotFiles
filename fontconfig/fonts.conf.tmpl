<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Generated by ~/.config/theme/apply-theme.sh from fonts.conf.tmpl - edit the
  template (or theme/fonts.sh), never fonts.conf.

  Points the generic `monospace` family at FONT_MONO_FAMILY. Anything that
  asks for "monospace" rather than a named font - Quickshell's control centre,
  Firefox's default monospace, many GTK/Qt widgets - otherwise gets DejaVu
  Sans Mono (`fc-match monospace`). Only the family is set here: weight stays
  whatever the app asks for (usually Regular), because forcing Medium at this
  level would also turn every app's "regular" request into Medium.
  Apps read this when they start; running ones keep their font.
-->
<fontconfig>
  <alias binding="strong">
    <family>monospace</family>
    <prefer>
      <family>{{FONT_MONO_FAMILY}}</family>
    </prefer>
  </alias>
</fontconfig>
