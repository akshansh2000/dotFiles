# Generated by ~/.config/theme/apply-theme.sh from this template - do not edit
# the real foot.ini by hand, edit this file (or colors.sh) instead.
#
# Catppuccin Mocha, entirely through colors.sh - since the palette was widened
# to all 26 Mocha colours on 2026-09-10 there are no literals left here. Values
# match /usr/share/foot/themes/catppuccin-mocha (which foot can't `include=`
# directly - the include file's [colors-dark] section is fine, our own
# generated section just needs to use that same name; plain [colors] is
# deprecated in current foot).

[colors-dark]
foreground={{TEXT}}
background={{BASE}}

regular0={{SURFACE1}}
regular1={{RED}}
regular2={{GREEN}}
regular3={{YELLOW}}
regular4={{BLUE}}
regular5={{PINK}}
regular6={{TEAL}}
regular7={{SUBTEXT1}}

bright0={{SURFACE2}}
bright1={{RED}}
bright2={{GREEN}}
bright3={{YELLOW}}
bright4={{BLUE}}
bright5={{PINK}}
bright6={{TEAL}}
bright7={{SUBTEXT0}}

cursor={{CRUST}} {{ROSEWATER}}

selection-foreground={{TEXT}}
# Was a one-off 414356, which is not a Catppuccin colour at all; surface1 is
# the palette's nearest equivalent and is what every other surface uses.
selection-background={{SURFACE1}}

search-box-no-match={{CRUST}} {{RED}}
search-box-match={{TEXT}} {{SURFACE0}}

jump-labels={{CRUST}} {{PEACH}}
urls={{BLUE}}

[main]
# Monospace font - single source of truth is theme/fonts.sh, not this
# file. Editing here gets overwritten on the next apply-theme.sh run.
font={{FONT_MONO_FAMILY}}:size={{FONT_MONO_SIZE_FOOT}}

[bell]
# Signal urgency to river over xdg-activation when BEL arrives in an unfocused
# window - that is what lights the urgent dot on the tag in waybar. Wayland has
# no X11-style urgency hint, so without this almost nothing ever marks a tag
# urgent. Off by default in foot.
urgent=yes

[text-bindings]
# Ctrl+Backspace deletes the previous word. By default foot sends it as ^H,
# which shells read as plain Backspace (one character). fish does bind
# ctrl-backspace, but only sees it when the extended-key negotiation gets
# through end to end, and inside tmux it does not - so instead the key is
# made to send exactly what Alt+Backspace sends (ESC DEL), which everything
# already understands as delete-word: fish (backward-kill-word, same as
# Ctrl+Alt+Backspace), Claude Code, readline. Done here rather than in tmux so
# it works the same in and out of tmux.
# Neovim caveat (for when it is set up): in insert mode ESC DEL arrives as
# <M-BS>; map that to <C-w> there, or it reads as Esc followed by Backspace.
\x1b\x7f = Control+BackSpace

[key-bindings]
# URL mode: Ctrl+Shift+O (foot's default) labels every URL on screen and opens
# the one whose label you type; Ctrl+Shift+Y is the same but copies it. foot
# has no copy binding by default. Inside tmux this only sees tmux's screen -
# tmux has its own Ctrl+click and prefix u (tmux.conf, links).
show-urls-copy=Control+Shift+y

[url]
# Underline OSC 8 hyperlinks all the time (default: only in URL mode), so a
# link whose text isn't a URL (ls --hyperlink file names, gh) is visible.
osc8-underline=always
