# Generated by ~/.config/theme/apply-theme.sh from this template - do not edit
# the real config by hand, edit this file (or colors.sh) instead.
#
# mako reloads on SIGUSR2 (`makoctl reload`), which apply-theme.sh does, so a
# palette change lands without restarting the service.

font={{FONT_SANS_FAMILY}} {{FONT_SANS_SIZE_MAKO}}
background-color=#{{MANTLE}}
text-color=#{{TEXT}}
border-color=#{{MAUVE}}
progress-color=over #{{SURFACE1}}

border-size=2
border-radius=8
padding=12
margin=8
width=360
height=120

anchor=top-right
default-timeout=5000
ignore-timeout=1

[urgency=low]
border-color=#{{SURFACE1}}
default-timeout=3000

[urgency=normal]
border-color=#{{MAUVE}}

# Critical notifications stay until dismissed - a timeout on something the
# sender marked critical defeats the point.
[urgency=critical]
border-color=#{{RED}}
default-timeout=0
