# Generated by ~/.config/theme/apply-theme.sh from this template - do not edit
# the real kitty.conf by hand, edit this file (or colors.sh/fonts.sh) instead.
# kitty is on trial next to foot (2026-10-17, Super+Shift+Return); everything
# here mirrors foot's behaviour, so the two can be compared like for like.
# kitty has no menus: Ctrl+Shift+F2 opens this config (edit the .tmpl!),
# Ctrl+Shift+F5 reloads it, Ctrl+Shift+F6 shows what differs from defaults.

# --- font ---
# Single source of truth is theme/fonts.sh (FONT_MONO_SIZE_KITTY = foot's
# size: both draw an 11x22 px cell at size 10 on the 1.3 scale).
font_family {{FONT_MONO_FAMILY}}
font_size {{FONT_MONO_SIZE_KITTY}}

# --- colours: Catppuccin Mocha, the same mapping as foot.ini.tmpl ---
# so a program looks identical in both terminals.
foreground #{{TEXT}}
background #{{BASE}}
selection_foreground #{{TEXT}}
selection_background #{{SURFACE1}}
cursor #{{ROSEWATER}}
cursor_text_color #{{CRUST}}
url_color #{{BLUE}}

color0  #{{SURFACE1}}
color1  #{{RED}}
color2  #{{GREEN}}
color3  #{{YELLOW}}
color4  #{{BLUE}}
color5  #{{PINK}}
color6  #{{TEAL}}
color7  #{{SUBTEXT1}}
color8  #{{SURFACE2}}
color9  #{{RED}}
color10 #{{GREEN}}
color11 #{{YELLOW}}
color12 #{{BLUE}}
color13 #{{PINK}}
color14 #{{TEAL}}
color15 #{{SUBTEXT0}}

# kitty's own tabs and splits (tmux does this job here, but if they are used
# they should look like the rest of the desktop: mauve = active, as in river
# and waybar).
tab_bar_background #{{CRUST}}
active_tab_foreground #{{CRUST}}
active_tab_background #{{MAUVE}}
inactive_tab_foreground #{{TEXT}}
inactive_tab_background #{{MANTLE}}
active_border_color #{{MAUVE}}
inactive_border_color #{{OVERLAY0}}
bell_border_color #{{YELLOW}}

# Like foot: a steady cursor.
cursor_blink_interval 0

# --- links ---
# Ctrl+click opens a link, the same as tmux (urls.sh) and alacritty; a plain
# click only selects. kitty opens on a plain click by default, and inside tmux
# (which grabs the mouse) on Ctrl+Shift+click. The press is discarded while
# grabbed, so tmux never sees the click and doesn't open the link a second
# time through its own Ctrl+click binding.
url_style straight
mouse_map left click ungrabbed mouse_handle_click selection prompt
# kitty's default Shift+click opens links too (it is also how a click gets
# past tmux); make it select only, so Ctrl+click is the one way to open.
mouse_map shift+left click grabbed,ungrabbed mouse_handle_click selection prompt
mouse_map ctrl+left release grabbed,ungrabbed mouse_handle_click link
mouse_map ctrl+left press grabbed discard_event
# Keyboard URL mode with foot's keys: Ctrl+Shift+O opens, Ctrl+Shift+Y copies
# (kitty's own Ctrl+Shift+E still opens too).
map ctrl+shift+o kitten hints --type url
map ctrl+shift+y kitten hints --type url --program @

# --- startup speed ---
# kitty runs its Python at -OO and looks for *.opt-2.pyc, which Void's package
# never generates, so every start compiled ~130 modules from source and failed
# to cache them under root-owned /usr/lib: ~1.1 s per launch (measured
# 2026-10-17). Super+Shift+Return therefore starts kitty with
# PYTHONPYCACHEPREFIX=~/.cache/kitty-pycache (-> ~275 ms cold, rebuilt by
# itself after updates) and --single-instance (-> ~30 ms for every further
# window). Cleared again here for windows/tabs opened from inside kitty;
# windows from Super+Shift+Return carry the launcher's environment and drop
# it with `env -u` in the binding instead.
env PYTHONPYCACHEPREFIX=

# --- behaviour carried over from foot ---
# Ctrl+Backspace deletes a word: send ESC DEL, exactly as foot.ini.tmpl does
# (see the comment there for why - fish, Claude Code and readline all read it
# as delete-word, in and out of tmux).
map ctrl+backspace send_text all \x1b\x7f
# Shift+Enter inside tmux (new line in Claude Code instead of sending). Under
# foot, tmux gets it through xterm's modifyOtherKeys (the `extkeys` feature);
# kitty refuses that mode on purpose (its own keyboard protocol replaces it,
# and tmux doesn't speak that), so tmux only ever got a plain Enter. Sending
# the CSI-u form ourselves works: tmux decodes it from any terminal and hands
# it on exactly as under foot (tested 2026-10-17: ESC[13;2u in -> ESC[27;2;13~
# out to a program that asked for extended keys). Only in windows started as
# `kitty tmux` (Super+Shift+Return) - outside tmux kitty does this natively,
# and a program that never asked would print the raw sequence.
map --when-focus-on cmdline:^tmux$ shift+enter send_text all \x1b[13;2u
# A bell marks the window urgent (xdg-activation), which lights the tag's dot
# in waybar - foot's [bell] urgent=yes. Silent, like foot.
window_alert_on_bell yes
enable_audio_bell no
# Super+Q closes without asking: tmux is always running, so kitty's default
# would ask every time. tmux keeps the session anyway.
confirm_os_window_close 0
